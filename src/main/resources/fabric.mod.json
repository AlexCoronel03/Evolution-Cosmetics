{
  "schemaVersion": 1,
  "id": "evolution_cosmetics",
  "version": "${version}",
  "name": "Cobblemon Evolution Cosmetics",
  "description": "Everstone / Eviolite in a Pokémon's cosmetic slot make it look like its earliest / middle evolution stage. Visual only.",
  "authors": ["AlexCoronel03"],
  "license": "MIT",
  "contact": { "sources": "https://github.com/AlexCoronel03/Evolution-Cosmetics" },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.evocosmetics.EvolutionCosmeticsMod"],
    "client": ["dev.evocosmetics.client.EvolutionCosmeticsClient"]
  },
  "mixins": [
    { "config": "evolution_cosmetics.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cobblemon": ">=1.8.1"
  }
}
